{
  "use_network_time": {
    "type": "bool",
    "description": "是否使用网络时间校准（开启后会定期从 timeapi.io 获取北京时间）",
    "default": true
  },
  "use_llm": {
    "type": "bool",
    "description": "开启LLM模式：让AI根据提示词自动生成问候语；关闭则发送固定文本",
    "default": false
  },
  "api_base": {
    "type": "string",
    "description": "LLM API 地址（如 https://api.deepseek.com/v1）",
    "default": "https://api.deepseek.com/v1"
  },
  "api_key": {
    "type": "string",
    "description": "LLM API 密钥",
    "default": ""
  },
  "model": {
    "type": "string",
    "description": "模型名称（如 deepseek-v4-flash）",
    "default": "deepseek-v4-flash"
  },
  "persona": {
    "type": "string",
    "description": "人格设定名称（对应AstrBot中的人格名，留空则使用全局默认人格）",
    "default": ""
  },
  "tasks": {
    "type": "template_list",
    "description": "定时任务列表，点击添加按钮创建新任务",
    "templates": {
      "default": {
        "name": "新任务",
        "items": {
          "time": {
            "type": "string",
            "description": "触发时间（HH:MM格式，北京时间）",
            "default": "08:00"
          },
          "umo": {
            "type": "string",
            "description": "目标会话UMO（如 FriendMessage:QQ号 或 GroupMessage:群号）",
            "default": ""
          },
          "prompt": {
            "type": "text",
            "description": "发送内容或LLM提示词",
            "default": ""
          }
        }
      }
    },
    "default": []
  }
}
