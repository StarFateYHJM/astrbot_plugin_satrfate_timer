{
  "use_llm": {
    "type": "bool",
    "description": "开启LLM生成",
    "default": false
  },
  "api_base": {
    "type": "string",
    "description": "LLM API地址",
    "default": "https://api.deepseek.com/v1"
  },
  "api_key": {
    "type": "string",
    "description": "LLM API密钥",
    "default": ""
  },
  "model": {
    "type": "string",
    "description": "模型名称",
    "default": "deepseek-v4-flash"
  },
  "system_prompt": {
    "type": "text",
    "description": "系统提示词",
    "default": ""
  },
  "tasks": {
    "type": "template_list",
    "description": "定时任务",
    "templates": {
      "default": {
        "name": "新任务",
        "items": {
          "time": {"type": "string", "description": "触发时间(HH:MM)", "default": "08:00"},
          "umo": {"type": "string", "description": "目标UMO", "default": ""},
          "prompt": {"type": "text", "description": "内容/提示词", "default": ""},
          "at_all": {"type": "bool", "description": "@全体成员", "default": false}
        }
      }
    },
    "default": []
  }
}
